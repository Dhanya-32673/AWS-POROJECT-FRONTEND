{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://sms-backend.us-east-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "http://sms-backend.us-east-1.elasticbeanstalk.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "http://sms-backend.us-east-1.elasticbeanstalk.com/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
